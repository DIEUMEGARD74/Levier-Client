NODE_ENV=production
PORT=8080
PUBLIC_HOST=levier-client.fr
PILOT_HOST=pilotage.levier-client.fr
CASH_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-tres-solide
SESSION_TTL_MS=86400000

# Agent OS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_PLACES_API_KEY=
PROSPECTION_CITY=Montpellier
PROSPECTION_RADIUS_METERS=12000
PROSPECTION_DAILY_LIMIT=20
PROSPECTION_REQUIRE_EMAIL=true
CONTACT_LOOKUP_LIMIT=5
CONTACT_PAGE_LIMIT=5
CONTACT_FETCH_TIMEOUT_MS=8000
PARTNER_TEMPS_LIBRE_URL=https://templibre.fr/
PARTNER_MANOVASITE_URL=

# Envoi e-mail Zoho. Garder SEND_MODE=approval tant que les tests ne sont pas validés.
SEND_MODE=approval
ZOHO_SMTP_HOST=smtppro.zoho.eu
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=bonjour@levier-client.fr
ZOHO_SMTP_PASS=
MAIL_FROM=bonjour@levier-client.fr
